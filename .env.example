# ==============================================================================
# DevPilot (PS-001) - Heterogeneous Multi-Agent Environment Configuration
# ==============================================================================
# Google Gemini API Key (or GOOGLE_API_KEY)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional Global Default Model Fallback
DEFAULT_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# Heterogeneous Multi-Agent Model Assignments (Subtask Specialized)
# ------------------------------------------------------------------------------
# 1. The Shogun's Council (Planner & Reconnaissance): Deep reasoning, task breakdown, architectural planning
SHOGUN_MODEL=gemini-2.5-pro
SHOGUN_TEMPERATURE=0.2

# 2. The Samurai Forge (Developer & Code Repair): Fast code generation, refactoring, tool execution
SAMURAI_MODEL=gemini-2.5-flash
SAMURAI_TEMPERATURE=0.1

# 3. The Sentinel Dojo (Empirical Tester & Independent Verifier): Evidence verification against acceptance criteria
SENTINEL_MODEL=gemini-2.5-flash
SENTINEL_TEMPERATURE=0.0

# 4. The Shadow Council (Strict Code Reviewer & Security Auditor): Multi-layer AST, security audits, quality critique
SHADOW_MODEL=gemini-2.5-pro
SHADOW_TEMPERATURE=0.0

# ------------------------------------------------------------------------------
# Execution Parameters
# ------------------------------------------------------------------------------
MAX_ITERATIONS=3
DEVPILOT_SERVER_PORT=8000
TARGET_REPO_PATH=./member4_server/sandbox_repos/01_feature_impl
